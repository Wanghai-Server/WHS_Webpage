            "vision": {
                "title": "我们是谁",
                "text": "望海是一个社区驱动型的《我的世界》Java 版公益服务器，现处于第二周目。我们以原版生存为核心，生产资料归全体玩家所有 —— 这里的每一座农场、每一条轨交线路、每一个公共仓库，都由社区成员共同建设、共同维护。",
                "items": [
                    { "title": "生电红石", "desc": "以生存红石为中心，拥有各类生物与资源农场，机器体系由社区共管共护。" },
                    { "title": "轨道交通", "desc": "统一规划的轨交工程与专用线路，连接社区的每一个角落，由专门负责人统筹。" },
                    { "title": "建筑规划", "desc": "生存与创造双服并行，大型建筑先在创造服规划，再落地到生存世界。" },
                    { "title": "社区共治", "desc": "所有者为全体玩家，管理员由玩家选举产生，规则由社区共同维护。" }
                ]
            },
