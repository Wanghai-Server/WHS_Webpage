                    { "time": "社区成形", "date": "2024/03/27 ~ 至今", "title": "共建共治", "desc": "管理员团队由玩家选举产生；审核问卷与审核群上线，新玩家需通过问卷审核加入；轨交工程统一规划，全物品仓库与农场体系逐步完善。" },
                    { "time": "现在与未来", "date": "2024/03/27 ~ 至今", "title": "持续共建", "desc": "社区持续吸纳新成员，基础设施不断扩展 —— 望海的每一块砖，都由玩家亲手砌成。" }
