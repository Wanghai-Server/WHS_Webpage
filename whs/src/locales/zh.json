            "about": {
                "title": "关于此网站",
                "text": "本网站作为望海服务器的官方网站，由望海服务器所有并负责运营。我们致力于为玩家打造一个高效、安全的账号管理与服务器服务窗口，同时亦是服务器官方社区与玩家数据资产管理的重要平台。",
                "items": [
                    { "title": "账号与安全", "desc": "注册、登录、头像与个人资料一站式管理；密码加盐哈希存储，登录态使用签名令牌，守护账号安全。" },
                    { "title": "入服考试", "desc": "审核问卷在线作答、自动判分，及格后自动加入游戏白名单，管理员可在线复审与评分。" },
                    { "title": "实时服务器状态", "desc": "在线人数、TPS 与玩家上限实时展示，数据由游戏服务器经 MCDR 插件自动上报。" },
                    { "title": "消息中心", "desc": "系统公告与定向消息集中推送，考试结果、审核通知等重要消息不错过。" },
                    { "title": "成员墙", "desc": "展示白名单正式成员，点击头像即可查看玩家信息与个人主页。" },
                    { "title": "双语与深色模式", "desc": "中英双语一键切换，浅色 / 深色 / 跟随系统三种主题，适配桌面与移动端。" }
                ],
                "techTitle": "本站技术栈",
                "techText": "前端基于 Vue 3 + Vite 构建，后端采用 FastAPI + SQLite，并与游戏服务器通过 MCDReforged 插件实时通信。项目遵循 MIT 协议开源。"
            },
            "copied": "已复制"
        }
