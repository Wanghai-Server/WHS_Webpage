            "governance": {
                "title": "社区与治理",
                "items": [
                    { "title": "玩家所有", "desc": "服务器明确「所有者为全体玩家」，生产资料归社区公有，任何人不得私有或垄断。" },
                    { "title": "民主选举", "desc": "管理员团队由玩家选举产生，并设有轨交工程负责人等职能岗位。" },
                    { "title": "问卷审核", "desc": "新玩家需通过审核问卷才能加入，确保每一位成员都了解并认同社区规则。" },
                    { "title": "准公有制", "desc": "大部分生产资料公有共享；下界合金、钻石等贵重物品的私有量有严格限制。" }
                ]
            },
            "features": {
                "title": "特色玩法",
                "items": [
                    { "title": "全物品分类仓库", "desc": "覆盖全物品的公共分类仓库，物资随取随用，由社区共同维护。" },
                    { "title": "轨道交通网络", "desc": "统一规划、专人负责的轨交工程，便捷连通各聚落与设施。" },
                    { "title": "生物与资源农场", "desc": "猪人塔、刷怪塔等各类生物与资源农场，为社区生产提供稳定保障。" },
                    { "title": "MCDR 便捷功能", "desc": "签到、坐标查询、旁观模式传送等插件功能，让游玩更顺畅。" },
                    { "title": "辅助模组政策", "desc": "允许小地图等辅助模组；投影打印机等工具在严格限定的场景下使用。" },
                    { "title": "创造服规划", "desc": "大型建筑先在创造服测试规划，再在生存世界落地，保证工程品质。" }
                ],
                "aiTitle": "服务器已接入 AI —— GamesAI",
